# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (PostgreSQL in production, SQLite fallback in development)
# For SQLite: sqlite:///app.db
# For PostgreSQL: postgresql://username:password@localhost:5432/gods_ocean_kitchen
DATABASE_URL=sqlite:///app.db

# CORS / Frontend origin (comma-separated or single URL)
FRONTEND_URL=http://localhost:3000,https://rselva1202.github.io

# Default Seed Credentials (can be overridden)
ADMIN_EMAIL=admin@godsowncountrykitchen.com
ADMIN_PASSWORD=admin123
